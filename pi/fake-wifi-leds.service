[Unit]
Description=Fake WiFi status LEDs (NeoPixel on GPIO18 PWM)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/fake-wifi-leds.py
Restart=always
RestartSec=2
# PWM bitstream is easily preempted by Wi-Fi IRQs on the Zero; niceness helps
# a little. FIFO may be denied — service still starts without it.
Nice=-10
LimitRTPRIO=20
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=20

[Install]
WantedBy=multi-user.target
